       "short": "Fun and games said"
      },
      {
       "type": "moment",
       "text": "“We saw your smoke.”",
       "short": "We saw your smoke"
      },
      {
       "type": "moment",
       "text": "“Having a war or something?”",
       "short": "Having a war or"
      },
      {
       "type": "moment",
       "text": "“The officer inspected the little scarecrow in front of him.”",
       "short": "The officer inspected the"
      },
      {
       "type": "moment",
       "text": "“The kid needed a bath, a haircut, a nose-wipe and a good deal of ointment.”",
       "short": "The kid needed a"
      },
      {
       "type": "moment",
       "text": "“Who’s boss here?”",
       "short": "Who’s boss here"
      },
      {
       "type": "moment",
       "text": "“I am,” said Ralph loudly.",
       "short": "I am said Ralph"
      },
      {
       "type": "moment",
       "text": "“Jolly good show. Like the Coral Island.”",
       "short": "Jolly good show Like"
      }
     ]
